# API
PORT=8080
ENV=development

# Database
#
# Hay dos setups validos y NO son intercambiables — elegi uno:
#
#   a) Docker Compose (docker-compose.yml): Postgres mapeado a :5433 porque
#      en la maquina de desarrollo el 5432 nativo ya esta ocupado.
#      DATABASE_URL=postgres://myvibesfit:myvibesfit@localhost:5433/myvibesfit?sslmode=disable
#
#   b) Postgres local nativo (lo que usan run-api.cmd y las sesiones sin
#      Docker): usuario postgres, base myvibesfit, puerto 5432.
#      DATABASE_URL=postgres://postgres:1234@localhost:5432/myvibesfit?sslmode=disable
#
# Las POSTGRES_* de abajo solo las lee docker-compose para crear el
# contenedor; con Postgres nativo no aplican.
DATABASE_URL=postgres://myvibesfit:myvibesfit@localhost:5433/myvibesfit?sslmode=disable
POSTGRES_USER=myvibesfit
POSTGRES_PASSWORD=myvibesfit
POSTGRES_DB=myvibesfit

# Auth
JWT_ACCESS_SECRET=change-me-in-production-min-32-chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# CORS — origenes permitidos, separados por coma. En development cae por
# defecto a localhost:5555 (Flutter web) y localhost:3000 (panel Next.js).
CORS_ALLOWED_ORIGINS=http://localhost:5555,http://localhost:3000

# IA (solo cmd/worker). Sin ANTHROPIC_API_KEY el worker corre pero falla al
# llamar a Claude; el resto del backend no lo necesita.
ANTHROPIC_API_KEY=
ANTHROPIC_SUGGESTION_MODEL=claude-opus-5

# Push notifications (SDD-001). Ambas OPCIONALES: sin FCM_CREDENTIALS_JSON la
# API arranca igual y el envio queda en no-op, asi que el desarrollo local no
# depende de una cuenta de Firebase. Si la ruta esta puesta y el archivo no se
# puede leer o parsear, el arranque falla a proposito en vez de degradarse en
# silencio. FCM_PROJECT_ID solo hace falta si el service account no lo trae.
FCM_CREDENTIALS_JSON=
FCM_PROJECT_ID=

# --- Despliegue con docker compose (Fase 2) ---
# Estos tres son OBLIGATORIOS al levantar el compose: no tienen default a
# proposito, porque un valor inventado daria un certificado invalido o un panel
# apuntando al backend equivocado.
API_DOMAIN=api.tu-dominio.com
PANEL_DOMAIN=panel.tu-dominio.com
PUBLIC_API_URL=https://api.tu-dominio.com

# ENV=production activa los guardas de config.Load: rechaza el secreto JWT de
# desarrollo y exige 32+ caracteres. En produccion CORS_ALLOWED_ORIGINS no
# tiene default permisivo, hay que declararlo.
ENV=production
POSTGRES_USER=myvibesfit
POSTGRES_PASSWORD=
POSTGRES_DB=myvibesfit
